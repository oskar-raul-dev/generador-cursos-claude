+"""loyalty: los puntos de fidelidad del cierre de 06/09. Un stub: escucha un hecho de pago y anota.
+
+Un punto por cada 10.00 pagados. Sin base: imprime. Qué hecho escucha lo decide quien lo arranca:
+  coreografía    PaymentAuthorized en payments.results   (lo publica payments)
+  orquestación   OrderPaid en orders.events              (lo publica el orquestador al terminar)
+"""
+import argparse
+import asyncio
+import json
+from decimal import Decimal
+
+from aiokafka import AIOKafkaConsumer
+
+
+async def run(brokers, topic, fact_type):
+    consumer = AIOKafkaConsumer(topic, bootstrap_servers=brokers, group_id="loyalty", auto_offset_reset="earliest")
+    await consumer.start()
+    print(f"loyalty consuming {fact_type} from {topic}", flush=True)
+    try:
+        async for msg in consumer:
+            ev = json.loads(msg.value)
+            if ev.get("type") != fact_type:
+                continue
+            amount = Decimal((ev.get("total") or ev.get("payment"))["amount"])
+            print(f"{fact_type} order={ev['orderId'][:8]} → +{int(amount // 10)} points", flush=True)
+    finally:
+        await consumer.stop()
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--topic", required=True)
+    p.add_argument("--type", required=True, dest="fact_type")
+    p.add_argument("--kafka", default="localhost:29092")
+    args = p.parse_args()
+    asyncio.run(run(args.kafka, args.topic, args.fact_type))
+
+
+if __name__ == "__main__":
+    main()
