+"""fraud: el control antifraude del cierre de 06/09. Un stub: la regla es de juguete.
+
+Regla: una línea con más de 5 unidades es sospechosa.
+
+  --mode http   (orquestación)  POST /checks {"orderId", "lines"} → {"passed": true|false, "reason"}
+  --mode kafka  (coreografía)   InventoryReserved (inventory.reservations) → FraudCheckPassed | FraudCheckFailed
+                                en fraud.results. Sin base: publica directo, sin outbox ni inbox (un stub).
+"""
+import argparse
+import asyncio
+import json
+import uuid
+from datetime import datetime, timezone
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+MAX_UNITS = 5
+
+
+def check(lines):
+    worst = max((l["quantity"] for l in lines), default=0)
+    return (True, None) if worst <= MAX_UNITS else (False, f"a line with {worst} units (max {MAX_UNITS})")
+
+
+class Handler(BaseHTTPRequestHandler):
+    def _body(self):
+        # el cliente HTTP del JDK (orders) manda el cuerpo chunked, sin Content-Length (06/01 §8)
+        if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
+            raw = b""
+            while (size := int(self.rfile.readline().split(b";")[0].strip(), 16)) > 0:
+                raw += self.rfile.read(size)
+                self.rfile.readline()
+            self.rfile.readline()
+            return raw
+        return self.rfile.read(int(self.headers.get("Content-Length") or 0))
+
+    def do_POST(self):
+        body = json.loads(self._body())
+        passed, reason = check(body["lines"])
+        out = json.dumps({"passed": passed, "reason": reason}).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(out)))
+        self.end_headers()
+        self.wfile.write(out)
+        print(f"check order={body['orderId'][:8]} → {'passed' if passed else 'FAILED: ' + reason}", flush=True)
+
+    def log_message(self, *args):
+        pass
+
+
+async def run_kafka(brokers):
+    from aiokafka import AIOKafkaConsumer, AIOKafkaProducer
+    consumer = AIOKafkaConsumer("inventory.reservations", bootstrap_servers=brokers, group_id="fraud",
+                                enable_auto_commit=False, auto_offset_reset="earliest")
+    producer = AIOKafkaProducer(bootstrap_servers=brokers)
+    await consumer.start()
+    await producer.start()
+    print("fraud consuming inventory.reservations", flush=True)
+    try:
+        async for msg in consumer:
+            ev = json.loads(msg.value)
+            if ev.get("type") == "InventoryReserved":
+                passed, reason = check(ev["lines"])
+                fact = {"eventId": str(uuid.uuid4()), "type": "FraudCheckPassed" if passed else "FraudCheckFailed",
+                        "version": 1, "occurredAt": datetime.now(timezone.utc).isoformat(), "orderId": ev["orderId"],
+                        "causationId": ev["eventId"], "lines": ev["lines"], "total": ev["total"], "reason": reason}
+                await producer.send_and_wait("fraud.results", json.dumps(fact).encode(), key=msg.key)
+                print(f"InventoryReserved order={ev['orderId'][:8]} → {fact['type']}", flush=True)
+            await consumer.commit()
+    finally:
+        await consumer.stop()
+        await producer.stop()
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--mode", choices=["http", "kafka"], required=True)
+    p.add_argument("--port", type=int, default=28086)
+    p.add_argument("--kafka", default="localhost:29092")
+    args = p.parse_args()
+    if args.mode == "kafka":
+        asyncio.run(run_kafka(args.kafka))
+    else:
+        print(f"fraud listening on :{args.port}", flush=True)
+        ThreadingHTTPServer(("0.0.0.0", args.port), Handler).serve_forever()
+
+
+if __name__ == "__main__":
+    main()
