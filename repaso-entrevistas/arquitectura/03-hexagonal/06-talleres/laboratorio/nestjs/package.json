{
  "name": "hex-orders-nestjs",
  "private": true,
  "version": "1.1.0",
  "description": "Sabor TypeScript + NestJS del bloque 06 · Talleres",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && npm start",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.12",
    "mongodb": "7.6.0",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.4.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
