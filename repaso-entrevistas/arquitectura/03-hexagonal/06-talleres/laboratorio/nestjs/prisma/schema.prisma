// Cliente generado dentro del adaptador de PostgreSQL y fuera del control de versiones:
// `npm run prisma:generate` lo regenera a partir de este esquema, que es la introspección
// (`prisma db pull`) del esquema compartido de laboratorio/contrato/seed/schema.sql.
generator client {
  provider        = "prisma-client"
  output          = "../src/infrastructure/outbound/postgres/generated"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model idempotency_keys {
  key             String
  actor_id        String   @db.Uuid
  request_hash    String
  response_status Int
  response_body   Json
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([key, actor_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  sku        String   @id
  available  Int
  version    BigInt   @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_reservations {
  id         String   @id @db.Uuid
  order_id   String   @db.Uuid
  sku        String
  quantity   Int
  status     String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "inventory_reservations_order_idx")
}

model notifications {
  id         String   @id @db.Uuid
  order_id   String   @db.Uuid
  type       String
  recipient  String
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_lines {
  order_id     String  @db.Uuid
  line_no      Int     @db.SmallInt
  sku          String
  product_name String
  quantity     Int
  unit_price   Decimal @db.Decimal(12, 2)
  orders       orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([order_id, line_no])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                     String                   @id @db.Uuid
  customer_id            String                   @db.Uuid
  status                 String
  total_amount           Decimal                  @db.Decimal(12, 2)
  currency               String                   @default("USD") @db.Char(3)
  version                BigInt                   @default(0)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  inventory_reservations inventory_reservations[]
  order_lines            order_lines[]
  users                  users                    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments               payments[]
}

model outbox {
  id             String    @id @db.Uuid
  aggregate_type String
  aggregate_id   String    @db.Uuid
  event_type     String
  payload        Json
  occurred_at    DateTime  @default(now()) @db.Timestamptz(6)
  published_at   DateTime? @db.Timestamptz(6)
  attempts       Int       @default(0)

  @@index([occurred_at], map: "outbox_pending_idx", where: raw("(published_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id           String   @id @db.Uuid
  order_id     String   @db.Uuid
  operation_id String   @unique
  status       String
  reference    String?
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD") @db.Char(3)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  sku        String   @id
  name       String
  unit_price Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD") @db.Char(3)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            String   @id @db.Uuid
  email         String   @unique
  password_hash String
  role          String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  orders        orders[]
}
