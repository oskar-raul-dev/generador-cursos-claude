APP_NAME=hex-orders-php
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8085
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL del laboratorio (§11): puerto 15432, base hex_orders
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=hex_orders
DB_USERNAME=hex
DB_PASSWORD=hex-lab-pass

# Sin sesiones, sin caché de aplicación, sin cola: es una API sin estado
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Redis por predis (PHP puro, sin ext-redis)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# Taller
HEX_CATALOG=postgres
HEX_MONGO_URL=mongodb://localhost:17017/hex_catalog
HEX_JWT_SECRET=hex-lab-dev-secret-change-me-0123456789
HEX_JWT_TTL_SECONDS=900
HEX_OUTBOX_POLL_MS=500
HEX_CORS_ORIGIN=http://localhost:5173
