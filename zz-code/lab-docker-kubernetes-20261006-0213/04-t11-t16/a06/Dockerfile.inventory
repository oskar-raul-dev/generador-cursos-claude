# Dockerfile definitivo de inventory (Fase 04): compila con el JDK y corre con el JRE.

# ── Etapa de build: JDK y Maven ──
# eclipse-temurin:25-jdk
FROM --platform=$BUILDPLATFORM eclipse-temurin@sha256:8c0a84ea11c8f6ed52600fc19f1040121f2a162998e9f50a5faebbbad9172dcc AS build
WORKDIR /src
# Primero el pom y el wrapper: las dependencias se bajan una vez y quedan en su capa mientras el pom no cambie.
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -q -B dependency:go-offline
COPY src src
# G10: el contrato gRPC, desde el contexto de build "proto" (contracts/proto; task build lo pasa con --build-context).
COPY --from=proto pricing src/main/proto/pricing
RUN ./mvnw -q -B package -DskipTests
# El jar por capas de Spring Boot: dependencias, cargador y aplicación, cada una en su carpeta.
RUN java -Djarmode=tools -jar target/inventory-0.0.1-SNAPSHOT.jar extract --layers --destination /out

# ── G13 (Fase 26): el publicador del outbox, en Go. Un binario estático que el sidecar corre desde esta misma imagen ──
# golang:1.27.1-alpine
FROM --platform=$BUILDPLATFORM golang@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS relay
ARG TARGETOS TARGETARCH
WORKDIR /relay
COPY relay/go.mod relay/go.sum ./
RUN go mod download
COPY relay/main.go ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/outbox-relay .

# ── Etapa final: el JRE, sin compilador ni Maven ──
# eclipse-temurin:25-jre — Ubuntu (glibc), con shell para depurar.
FROM eclipse-temurin@sha256:fcd7fd7b387f94bb2ac461478a7436ad8e349924c374ea8313919624dceae636
# Un usuario sin privilegios, con uid fijo para que los volúmenes y la Fase 20 sepan quién es,
# y la carpeta de los datos (G1) a su nombre: un volumen que se monte aquí hereda el dueño (Fase 03).
RUN useradd --system --uid 10001 --no-create-home inventory \
    && mkdir -p /var/lib/inventory && chown inventory /var/lib/inventory
WORKDIR /app
# De lo que menos cambia a lo que más: las dependencias casi nunca, la aplicación en cada commit.
COPY --from=build /out/dependencies/ ./
COPY --from=build /out/spring-boot-loader/ ./
COPY --from=build /out/snapshot-dependencies/ ./
COPY --from=build /out/application/ ./
# G10: el agente de OpenTelemetry, con su suma: instrumenta Spring, el cliente HTTP, JDBC y gRPC sin tocar el código.
# Se apaga con OTEL_JAVAAGENT_ENABLED=false (el chart lo hace mientras las trazas están apagadas). --chmod: ADD
# desde una URL deja el archivo en 0600 de root, y la JVM, que corre como 10001, no lo podría leer.
ADD --chmod=644 --checksum=sha256:f787eb6c7f3d18e69a431e108a15278d25ee37f83d68b678f621e063f3988f82 \
    https://repo1.maven.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/2.32.0/opentelemetry-javaagent-2.32.0.jar \
    /app/opentelemetry-javaagent.jar
# G13: el sidecar del outbox corre este binario (command: /app/outbox-relay); la aplicación no lo usa.
COPY --from=relay /out/outbox-relay /app/outbox-relay
USER inventory
EXPOSE 8080
# G7: sqlite-jdbc carga una biblioteca nativa, y Java 25 avisa en stderr, en texto, al hacerlo: el permiso
# explícito lo calla (y el log queda en JSON).
CMD ["java", "--enable-native-access=ALL-UNNAMED", "-javaagent:/app/opentelemetry-javaagent.jar", "-jar", "inventory-0.0.1-SNAPSHOT.jar"]
